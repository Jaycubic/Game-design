# Nature's Thread — environment template.
# Copy to `.env` and replace every placeholder. `.env` is git-ignored and is
# never packaged. The server refuses to start with placeholder secrets.

# ── Application ─────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
HOST=0.0.0.0
HTTP_PORT=8070
RUST_LOG=info,natures_thread_server=info

# ── HTTPS (needed for WebGPU on other LAN devices) ──────────────────────────
# Leave both empty to serve plain HTTP (WebGPU then only works on localhost;
# other devices fall back to WebGL2). `make certs` creates a local CA and a
# server certificate under ./certs.
TLS_CERT=
TLS_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://<db_user>:<db_password>@127.0.0.1:5432/natures_thread
DB_MAX_CONNECTIONS=10

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 48     (at least 32 characters)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_HOURS=24

# ── Rooms ───────────────────────────────────────────────────────────────────
ROOM_MIN_PLAYERS=2
ROOM_MAX_PLAYERS=4
ROOM_CODE_LENGTH=6
ROOM_RECONNECT_GRACE_SECONDS=120
ROOM_IDLE_EXPIRY_HOURS=12

# ── Browser origins allowed to call the API (comma-separated) ───────────────
ALLOWED_ORIGINS=https://localhost:8070,http://localhost:5173

# Built client served by the Rust server
STATIC_DIR=./client/dist
